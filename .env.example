# RYMseek Configuration Reference / Environment Variables
# These values match the defaults configured inside the Chrome Extension.
# You can customize these within the Chrome Extension Options page (chrome://extensions -> RYMseek Options).

# slskd Base URL (REST API)
SLSKD_URL=https://slskd.furroge.uk

# slskd Web UI Login Credentials (Option 1: Recommended for standard slskd docker setups)
SLSKD_USERNAME=
SLSKD_PASSWORD=

# slskd API Key (Configured under web.authentication.api_keys in slskd.yml)
SLSKD_API_KEY=slskdDownloadTest

# Navidrome Web Interface URL (for quick access and library check)
NAVIDROME_URL=https://music.furroge.uk

# Preferred Audio Format (options: flac, mp3_320, any)
PREFERRED_FORMAT=flac

# Minimum Upload Speed Filter in KB/s (0 = no filter)
MIN_UPLOAD_SPEED_KBPS=0

# Maximum user queue length before skipping a peer (default: 50)
MAX_USER_QUEUE=50

# Search polling timeout in seconds (default: 10)
SEARCH_TIMEOUT_SECONDS=10

# Fallback minimum track count if tracklist cannot be counted from the RYM page (default: 4)
MIN_TRACK_COUNT_FALLBACK=4
