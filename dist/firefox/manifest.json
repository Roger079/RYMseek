{
  "manifest_version": 3,
  "name": "RYMseek - RateYourMusic to slskd / Navidrome",
  "version": "1.0.0",
  "description": "Injects a direct download action into RateYourMusic release pages to search and queue albums via slskd into your Navidrome library.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rymseek@furroge.uk",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://rateyourmusic.com/release/album/*",
        "https://rateyourmusic.com/release/mixtape/*",
        "https://rateyourmusic.com/release/ep/*",
        "https://rateyourmusic.com/release/single/*",
        "https://rateyourmusic.com/release/comp/*",
        "https://rateyourmusic.com/release/bootleg/*",
        "https://rateyourmusic.com/release/djmix/*",
        "https://rateyourmusic.com/release/video/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RYMseek - slskd / Navidrome Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}